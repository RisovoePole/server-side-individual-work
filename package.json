{
  "name": "traveltrack-server",
  "version": "1.0.0",
  "private": true,
  "description": "Server-side приложение для учёта туристических поездок и расходов (Node.js, Express, Sequelize, PostgreSQL)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "seed": "node scripts/seed.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:socket": "node scripts/verify-socket.js",
    "test": "node scripts/smoke-test.js && node scripts/verify-socket.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "sequelize": "^6.37.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
