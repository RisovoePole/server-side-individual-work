<%- include('../partials/header') %>

<div class="page-head">
  <div>
    <a class="back-link" href="/venues">← Все площадки</a>
    <h1><%= mode === 'edit' ? 'Редактирование площадки' : 'Новая площадка' %></h1>
    <p class="muted">Поля, помеченные звёздочкой, обязательны.</p>
  </div>
</div>

<div class="card form-card">
  <form method="post" action="<%= mode === 'edit' ? '/venues/' + values.id : '/venues' %>" novalidate>
    <div class="form-grid">
      <div class="form-group">
        <label for="title">Название *</label>
        <input id="title" name="title" type="text" value="<%= values.title || '' %>" required>
        <% if (fieldError('title')) { %><span class="field-error"><%= fieldError('title') %></span><% } %>
      </div>

      <div class="form-group">
        <label for="sport">Вид спорта *</label>
        <select id="sport" name="sport" required>
          <option value="">Выберите вид спорта</option>
          <% SPORTS.forEach(function (sport) { %>
            <option value="<%= sport.value %>" <%= values.sport === sport.value ? 'selected' : '' %>><%= sport.label %></option>
          <% }); %>
        </select>
        <% if (fieldError('sport')) { %><span class="field-error"><%= fieldError('sport') %></span><% } %>
      </div>

      <div class="form-group">
        <label for="city">Город *</label>
        <input id="city" name="city" type="text" value="<%= values.city || '' %>" required>
        <% if (fieldError('city')) { %><span class="field-error"><%= fieldError('city') %></span><% } %>
      </div>

      <div class="form-group">
        <label for="address">Адрес *</label>
        <input id="address" name="address" type="text" value="<%= values.address || '' %>" required>
        <% if (fieldError('address')) { %><span class="field-error"><%= fieldError('address') %></span><% } %>
      </div>

      <div class="form-group">
        <label for="pricePerHour">Цена за час, € *</label>
        <input id="pricePerHour" name="pricePerHour" type="number" step="0.01" min="0" value="<%= values.pricePerHour || '' %>" required>
        <% if (fieldError('pricePerHour')) { %><span class="field-error"><%= fieldError('pricePerHour') %></span><% } %>
      </div>

      <div class="form-group">
        <label for="photoUrl">Ссылка на фото</label>
        <input id="photoUrl" name="photoUrl" type="url" value="<%= values.photoUrl || '' %>" placeholder="https://...">
        <% if (fieldError('photoUrl')) { %><span class="field-error"><%= fieldError('photoUrl') %></span><% } %>
      </div>

      <div class="form-group full-width">
        <label for="description">Описание *</label>
        <textarea id="description" name="description" rows="5" required><%= values.description || '' %></textarea>
        <% if (fieldError('description')) { %><span class="field-error"><%= fieldError('description') %></span><% } %>
      </div>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit"><%= mode === 'edit' ? 'Сохранить изменения' : 'Добавить площадку' %></button>
      <a class="btn btn-ghost" href="/venues">Отмена</a>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
